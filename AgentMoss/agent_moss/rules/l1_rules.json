{
  "dangerous_commands": [
    {
      "pattern": "\\brm\\s+-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*\\s+/(?!\\w)",
      "risk_level": "critical",
      "risk_type": "script_execution",
      "reason": "检测到递归强制删除根目录 (rm -rf /)"
    },
    {
      "pattern": "\\brm\\s+-[a-zA-Z]*[rf][a-zA-Z]*\\s+/(etc|var(?!/tmp)|home|usr|boot|root|opt|srv|sys|proc)\\b",
      "risk_level": "critical",
      "risk_type": "script_execution",
      "reason": "检测到删除关键系统目录"
    },
    {
      "pattern": "\\brm\\s+-[a-zA-Z]*r[a-zA-Z]*\\s+/(?!tmp|var/tmp|run|dev/shm|mnt|media)(?:/|\\b)",
      "risk_level": "medium",
      "risk_type": "script_execution",
      "reason": "检测到递归删除操作 (rm -r /...)"
    },
    {
      "pattern": "\\brm\\s+-[a-zA-Z]*f[a-zA-Z]*\\s+/(?!tmp/|var/tmp/|run/|dev/shm/)",
      "risk_level": "medium",
      "risk_type": "script_execution",
      "reason": "检测到强制删除文件 (rm -f /...)"
    },
    {
      "pattern": "chmod\\s+(?:(?:-[a-zA-Z]*|--)\\s+)*[0-7]{0,3}7\\b",
      "risk_level": "critical",
      "risk_type": "privilege_escalation",
      "reason": "检测到危险权限设置 (chmod ...7, other 位含写+执行敞口; 含 -R 递归与 -- 分隔符形态)"
    },
    {
      "pattern": "chmod\\s+(?:(?:-[a-zA-Z]*|--)\\s+)*[2-7][0-7]{3}\\b",
      "risk_level": "critical",
      "risk_type": "privilege_escalation",
      "reason": "检测到 setuid/setgid 位设置 (chmod 4xxx/2xxx/6xxx 及 3/5/7xxx 组合位, 提权; 含 -R 递归与 -- 分隔符形态)"
    },
    {
      "pattern": "chmod\\s+[ugoa]\\+s\\b",
      "risk_level": "critical",
      "risk_type": "privilege_escalation",
      "reason": "检测到符号 setuid/setgid 设置 (chmod u+s/g+s/a+s, 提权)"
    },
    {
      "pattern": "chown\\s+root|chown\\s+-R\\s+\\w+:\\w+\\s+/",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "修改所有者为 root / 递归修改根目录所有者"
    },
    {
      "pattern": "sudo\\s+(rm|chmod|chown|dd|mkfs|format|iptables|crontab|passwd|userdel|useradd|groupdel)\\b",
      "risk_level": "high",
      "risk_type": "privilege_escalation",
      "reason": "检测到提权执行高危命令 (sudo + 危险操作)"
    },
    {
      "pattern": "/etc/shadow",
      "risk_level": "critical",
      "risk_type": "file_access",
      "reason": "检测到访问系统密码文件 (/etc/shadow)"
    },
    {
      "pattern": "/etc/gshadow",
      "risk_level": "critical",
      "risk_type": "file_access",
      "reason": "检测到访问系统组密码文件 (/etc/gshadow)"
    },
    {
      "pattern": "\\.ssh/id_rsa(?!\\.pub)",
      "risk_level": "critical",
      "risk_type": "file_access",
      "reason": "检测到访问 SSH 私钥文件 (.ssh/id_rsa)"
    },
    {
      "pattern": "dd\\s+if=/dev/zero.*\\bof\\s*=\\s*/(etc|var|home|usr|boot|root|opt|srv|sys|proc)\\b",
      "risk_level": "critical",
      "risk_type": "script_execution",
      "reason": "检测到磁盘清零写入关键系统目录 (dd if=/dev/zero of=/系统目录)"
    },
    {
      "pattern": "mkfs\\.\\w+\\s+/dev/(sd|hd|nvme|vd|loop|mapper|md|dm)\\S+",
      "risk_level": "critical",
      "risk_type": "script_execution",
      "reason": "检测到格式化块设备 (mkfs /dev/块设备)"
    },
    {
      "pattern": ">\\s*/etc/",
      "risk_level": "critical",
      "risk_type": "file_access",
      "reason": "检测到覆盖写入系统配置目录"
    },
    {
      "pattern": ">\\s*/dev/(sd|hd|nvme|vd|loop|mem|kmsg|port|zero|random|urandom|full|core)",
      "risk_level": "high",
      "risk_type": "file_access",
      "reason": "检测到重定向写入设备文件"
    },
    {
      "pattern": "/var/run/docker\\.sock",
      "risk_level": "critical",
      "risk_type": "privilege_escalation",
      "reason": "检测到访问 Docker socket，可能导致容器逃逸"
    },
    {
      "pattern": "git\\s+push\\s+.*--force",
      "risk_level": "medium",
      "risk_type": "script_execution",
      "reason": "检测到强制推送操作 (git push --force)，可能覆盖远程提交历史"
    },
    {
      "pattern": "curl\\s+.*-X\\s+POST.*\\b(env|environment|secret|key|token|password)\\b",
      "risk_level": "high",
      "risk_type": "data_exfiltration",
      "reason": "检测到通过 curl POST 外传可能包含敏感信息的请求"
    },
    {
      "pattern": "\\b(?:curl|wget)\\b[^;&|\\n]*(?:-T|--upload-file)\\s+[^;&|\\n]*(?:/etc/shadow|/etc/passwd|/etc/master\\.passwd|id_rsa|id_dsa|id_ecdsa|id_ed25519|\\.aws/credentials|credentials|known_hosts|[^\\s/]*\\.db|secret[^\\s]*|\\.ssh)[^;&|\\n]*https?://(?!127\\.\\d+\\.\\d+\\.\\d+|0\\.0\\.0\\.0|localhost|\\[?::1\\]?)",
      "risk_level": "critical",
      "risk_type": "data_exfiltration",
      "reason": "检测到通过 curl/wget -T/--upload-file 上传敏感文件到外部服务器（数据外传）"
    },
    {
      "pattern": "\\bnmap\\s+",
      "risk_level": "high",
      "risk_type": "lateral_movement",
      "reason": "检测到网络端口扫描 (nmap)，可能用于横向移动侦察"
    },
    {
      "pattern": "\\b(masscan|zmap|unicornscan)\\s+",
      "risk_level": "high",
      "risk_type": "lateral_movement",
      "reason": "检测到网络端口扫描工具，可能用于横向移动侦察"
    },
    {
      "pattern": ">>\\s*(~|/home/[^/]+)/(\\.bashrc|\\.zshrc|\\.profile|\\.bash_profile|\\.zprofile)",
      "risk_level": "high",
      "risk_type": "persistence",
      "reason": "检测到修改 Shell 配置文件（~/.bashrc 等），可能用于持久化后门"
    },
    {
      "pattern": ">>\\s*\\S*/(\\.bashrc|\\.zshrc|\\.profile|\\.bash_profile|\\.zprofile)\\b",
      "risk_level": "high",
      "risk_type": "persistence",
      "reason": "检测到修改 Shell 配置文件（.bashrc 等），可能用于持久化后门"
    },
    {
      "pattern": "(?:curl|wget)\\s+.*(?:-o|--output|>)\\s*\\S+\\.(?:sh|bash)\\b",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到远程下载脚本到本地 (curl -o script.sh)，存在后续执行风险"
    },
    {
      "pattern": "(?:curl|wget)\\s+\\S+.*\\b(?:chmod|chown)\\s+\\+x\\b",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到远程下载后修改可执行权限，存在远程代码执行风险"
    },
    {
      "pattern": "\\|\\s*passwd\\b",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到管道方式调用 passwd（非交互式密码修改）"
    },
    {
      "pattern": "\\bpasswd\\s+--stdin\\b",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到 passwd --stdin 非交互式密码输入"
    },
    {
      "pattern": "\\bchpasswd\\b",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到 chpasswd 批量密码修改命令"
    },
    {
      "pattern": "\\b(newusers|lnewusers)\\b",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到 newusers/lnewusers 批量用户添加命令"
    },
    {
      "pattern": "\\bpasswd\\s+-[a-zA-Z]*d\\b",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到删除用户密码操作 (passwd -d)"
    },
    {
      "pattern": "\\bpasswd\\s+-[a-zA-Z]*l\\b",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到锁定用户账户操作 (passwd -l)"
    },
    {
      "pattern": "\\blpasswd\\s",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到非交互式密码修改操作 (lpasswd)"
    },
    {
      "pattern": "\\bgpasswd\\s+(?!-[adA])",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到组密码管理操作 (gpasswd)"
    },
    {
      "pattern": "\\bchgpasswd\\b",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到批量修改组密码操作 (chgpasswd)"
    },
    {
      "pattern": "\\buserdel\\s",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到删除系统用户操作 (userdel)"
    },
    {
      "pattern": "\\bdeluser\\s",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到删除系统用户操作 (deluser)"
    },
    {
      "pattern": "\\bluserdel\\s",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到删除系统用户操作 (luserdel)"
    },
    {
      "pattern": "\\bgroupdel\\s",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到删除用户组操作 (groupdel)"
    },
    {
      "pattern": "\\blgroupdel\\s",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到删除用户组操作 (lgroupdel)"
    },
    {
      "pattern": "\\b(useradd|luseradd|groupadd|usermod|lusermod|groupmod|lgroupmod)\\b[^&|;]*?\\s-p\\b",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "检测到通过 -p 参数设置或修改密码 (useradd/usermod/groupmod)"
    },
    {
      "pattern": ":\\(\\)\\s*\\{.*:\\|:&.*\\};:",
      "risk_level": "critical",
      "risk_type": "resource_exhaustion",
      "reason": "Fork Bomb"
    },
    {
      "pattern": "curl\\s+.*\\|\\s*bash",
      "risk_level": "high",
      "risk_type": "sensitive_action",
      "reason": "curl pipe bash 执行 (user_rules)"
    },
    {
      "pattern": "curl\\s+.*\\|\\s*(sh|zsh|dash)",
      "risk_level": "critical",
      "risk_type": "script_execution",
      "reason": "curl pipe shell 执行"
    },
    {
      "pattern": "wget\\s+.*\\|\\s*(bash|sh)",
      "risk_level": "critical",
      "risk_type": "script_execution",
      "reason": "wget pipe shell 执行"
    },
    {
      "pattern": "eval\\s+\\$\\(curl|eval\\s+\\$\\(wget",
      "risk_level": "critical",
      "risk_type": "script_execution",
      "reason": "eval 远程代码执行"
    },
    {
      "pattern": "base64\\s+-d\\s+.*\\|\\s*bash",
      "risk_level": "high",
      "risk_type": "sensitive_action",
      "reason": "base64 解码执行 (user_rules)"
    },
    {
      "pattern": "/dev/tcp/|bash\\s+-i\\s+>&",
      "risk_level": "critical",
      "risk_type": "script_execution",
      "reason": "反弹 Shell"
    },
    {
      "pattern": "nc\\s+-[el]\\s+.*\\d{1,5}",
      "risk_level": "high",
      "risk_type": "lateral_movement",
      "reason": "Netcat 反弹连接"
    },
    {
      "pattern": ">\\s*/boot/",
      "risk_level": "critical",
      "risk_type": "file_access",
      "reason": "覆盖写入启动引导目录"
    },
    {
      "pattern": "(?:curl|wget)\\s+.*\\s+&&?\\s*(?:chmod\\s+\\+x|bash|sh)",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "下载后执行"
    },
    {
      "pattern": "git\\s+clone\\s+.*\\|.*bash",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "git clone pipe shell"
    },
    {
      "pattern": "pip\\s+install\\s+.*\\|\\s*bash",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "pip install pipe shell"
    },
    {
      "pattern": "npm\\s+install\\s+-g\\s+.*\\|\\s*bash",
      "risk_level": "high",
      "risk_type": "script_execution",
      "reason": "npm install pipe shell"
    },
    {
      "pattern": "export\\s+.*(?:TOKEN|KEY|SECRET|PASSWORD)",
      "risk_level": "medium",
      "risk_type": "data_exfiltration",
      "reason": "导出敏感凭证"
    },
    {
      "pattern": "(?:\\$\\(|`)\\s*(?:\\S+=\\S*\\s+)*(?:touch|rm|mkdir|mv|cp|dd|tee|truncate|chmod|chown|mkfifo|mknod|ln|shred|mkfs|nc|ncat|socat|bash|sh|zsh|dash|python|python3|perl|ruby|node|php|eval|exec|base64|sudo|su)\\b",
      "risk_level": "critical",
      "risk_type": "script_execution",
      "reason": "检测到命令替换隐藏执行（$(...)/反引号载荷含写/执行命令），可能产生文件系统副作用"
    }
  ],
