      "deny_mode": "deny_write",
      "dir_del_only": true,
      "scope": "home"
    },
    {
      "path": ".aws",
      "risk_level": "critical",
      "desc": "AWS 配置目录（凭据所在）——整目录删除拦截，目录内文件按具体路径规则（读 .aws/config 非凭据配置放行、写 credentials 拦截），目录创建/权限设置放行",
      "deny_mode": "deny_write",
      "dir_del_only": true,
      "scope": "home"
