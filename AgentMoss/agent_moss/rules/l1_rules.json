  "sensitive_path_access": [
    {
      "path": "/etc/shadow",
      "risk_level": "critical",
      "desc": "系统密码文件",
      "deny_mode": "deny_both",
      "scope": "root"
    },
    {
      "path": "/etc/gshadow",
      "risk_level": "critical",
      "desc": "系统组密码文件",
      "deny_mode": "deny_both",
      "scope": "root"
    },
    {
      "path": "/etc/passwd",
      "risk_level": "high",
      "desc": "系统用户文件",
      "deny_mode": "deny_write",
      "scope": "root"
    },
    {
      "path": "/etc/sudoers",
      "risk_level": "critical",
      "desc": "sudo 配置",
      "deny_mode": "deny_both",
      "scope": "root"
    },
