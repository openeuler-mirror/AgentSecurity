  "write_exec_chain_patterns": [
    {
      "pattern": "(?:echo|cat|printf)\\b.*?>\\s*\\S+.*(?:&&|;|\\|)\\s*(?:bash|sh|zsh|python\\d?|perl|ruby|node|php)\\s",
      "flags": "is"
    },
    {
      "pattern": "\\|\\s*(?:bash|sh|zsh|python\\d?|perl|ruby|node|php)\\b",
      "flags": "i"
    },
    {
      "pattern": "eval\\s+\\\"\\$\\(",
      "flags": "i"
    },
    {
      "pattern": "\\|\\s*xargs\\s+(?:bash|sh|zsh)",
      "flags": "i"
    }
  ],
  "danger_evidence_patterns": {
    "_comment": "内联脚本补位判定的准入闸（2026-11）：代码里必须命中其中之一（或出现敏感路径），才值得进 inline 语义判定。动机：补位判定原先只要求「是内联脚本」，而 analyze_inline_script 的步骤 2 只看读写调用词（open( / system( ...），导致 Image.open('/tmp/x.png')、print(open('/tmp/x').read()) 这类正常脚本被 critical 误杀（0.15.4 起）。只放明确的破坏性动作，避免误伤正常文件处理脚本。",
    "patterns": [
      "\\brm\\s+-[a-zA-Z]*[rf][a-zA-Z]*\\s+\\S+",
      "\\bmkfs(?:\\.\\w+)?\\b",
      "\\bdd\\s+if=",
      "\\bchmod\\s+[0-7]*[2367][0-7]{2}\\b",
      "\\bchown\\s+root\\b",
      "\\b(?:shutdown|reboot|halt|poweroff)\\b",
      "\\buserdel\\b|\\bchpasswd\\b",
      "\\bcrontab\\s+-",
      "\\bcurl\\b[^|\\n]*\\|\\s*(?:bash|sh|zsh)\\b",
      "\\bwget\\b[^|\\n]*\\|\\s*(?:bash|sh|zsh)\\b",
      "/dev/(?:tcp|udp)/",
      "authorized_keys",
      "\\.ssh/id_(?:rsa|ed25519)"
    ]
  },
  "redirect_sensitive_paths": {
    "_comment": "「重定向写到敏感路径」的路径清单。**两端口径本就不同，此处只做搬家、未统一**：Python 优先用 profile.sensitive_paths 动态编译（含 ~/.bashrc 等），python_fallback 仅在没有 profile 时兜底（生产不触发）；TS 无 profile 注入，用 ts_static + shell_rc_fragments 静态拼。统一两端口径是独立事项，改动会直接改变判定，不要顺手做。",
    "python_fallback": [
