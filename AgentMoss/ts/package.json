{
  "name": "@kenhkl/agent-moss",
  "version": "0.15.1",
  "description": "Multi-layer security analysis engine for AI agents (TypeScript)",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "agent-moss": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/server.js"
    },
    "./engine": {
      "import": "./dist/engine/coordinator.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.cjs",
    "dev": "tsx src/cli.ts server --port 9090",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@lezer/python": "^1.1.19",
    "hono": "^4.6.0",
    "openai": "^4.104.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
